# Copie a .env (raíz del repo) y ajuste. docker compose lo lee automáticamente.

# Credenciales de PostgreSQL (solo dentro de la red de compose; db no publica puertos).
POSTGRES_USER=voltrix
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=alertas

# Cadena de conexión que usa la API. En compose se arma con las variables de arriba;
# defínala solo si corre la API fuera de compose.
# DATABASE_URL=postgresql://voltrix:cambie-esta-clave@localhost:5432/alertas

# URL base de Telemetría de Plantas (Equipo 2), sin barra final. Vacía: lecturas de ejemplo.
TELEMETRIA_URL=

# Workers por defecto para modo=paralelo.
WORKERS=4

# Peticiones simultáneas antes de responder 429 SOBRECARGA (no cuenta /health ni /openapi.yaml).
MAX_CONCURRENCIA=16
