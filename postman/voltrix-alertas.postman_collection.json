            "url": {
              "raw": "{{baseUrl}}/alertas/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alertas",
                "estado"
              ]
            },
            "description": "Lo que consume Mantenimiento Predictivo: solo activas, con `porSeveridad` y `resumenPorActivo`."
          }
