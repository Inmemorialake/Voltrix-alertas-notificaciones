        {
          "name": "Lote mixto: turbina y panel (secuencial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"X-Request-Id es un uuid\", () => {",
